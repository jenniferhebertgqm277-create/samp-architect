stock UnloadMap_LS_Airport_Exterior()
{
    for(new i = 0; i < sizeof(g_MapObjects_LS_Airport_Exterior); i++)
    {
        if(IsValidDynamicObject(g_MapObjects_LS_Airport_Exterior[i]))
        {
            DestroyDynamicObject(g_MapObjects_LS_Airport_Exterior[i]);
            g_MapObjects_LS_Airport_Exterior[i] = 0;
        }
    }
    return 1;
}

public OnFilterScriptInit()
{
    print("\n======================================");
    print(" [MAP] LS_Airport_Exterior Loaded (167 Objects, 84 Removals)");
    print("======================================\n");
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i)) RemoveBuildings_LS_Airport_Exterior(i);
    }
    LoadMap_LS_Airport_Exterior();
    return 1;
}

public OnFilterScriptExit()
{
    UnloadMap_LS_Airport_Exterior();
    return 1;
}

public OnPlayerConnect(playerid)
{
    RemoveBuildings_LS_Airport_Exterior(playerid);
    return 1;
}

public OnPlayerCommandText(playerid, cmdtext[])
{
    if(!strcmp(cmdtext, "/airport", true) || !strcmp(cmdtext, "/gotoairport", true))
    {
        SetPlayerPos(playerid, 1680.0000, -2285.0000, 14.5000);
        SetPlayerFacingAngle(playerid, 0.0);
        SetCameraBehindPlayer(playerid);
        SendClientMessage(playerid, 0x00FF00AA, "[MAP] Teleported to LS_Airport_Exterior!");
        return 1;
    }
    return 0;
}